{
  "name": "@rheactor/rheactor-core",
  "version": "2.0.0",
  "private": true,
  "description": "Rheactor core functions.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*"
    ],
    "#tests/*": [
      "./tests/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/index.next.d.mts",
      "default": "./dist/index.next.mjs"
    },
    "./node": {
      "types": "./dist/index.node.d.mts",
      "default": "./dist/index.node.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "npm run typecheck && npm run eslint && npm run oxfmt",
    "lint:fix": "npm run typecheck && npm run eslint:fix && npm run oxfmt:fix",
    "typecheck": "tsc --noEmit",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "eslint": "eslint ./src ./tests",
    "eslint:fix": "eslint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "eslint": "^10.7.0",
    "next": "^16.2.10",
    "oxfmt": "^0.59.0",
    "tsdown": "^0.22.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "next": "^16.2.10"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
